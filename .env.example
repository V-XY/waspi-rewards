# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only Supabase credential. Never expose as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY

# White-label tenant
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=ebu-flow

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional integrations
WHATSAPP_PHONE_NUMBER_ID=placeholder
WHATSAPP_ACCESS_TOKEN=placeholder
NEXT_PUBLIC_EMAILJS_SERVICE_ID=placeholder
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=placeholder
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=placeholder

# MTN MoMo - server only when API access is enabled
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_COLLECTION_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=placeholder
MTN_MOMO_API_USER=placeholder
MTN_MOMO_API_KEY=placeholder
MTN_MOMO_CALLBACK_HOST=https://example.com

# Feature flags
DEMO_ENABLED=false
CRON_SECRET=placeholder
